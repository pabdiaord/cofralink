# Copia este archivo a backend/.env solo para desarrollo local. En producción
# inyecta estas variables desde el proveedor de secretos, nunca desde Git.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
TRUST_X_FORWARDED_PROTO=True

DB_NAME=cofralink
DB_USER=cofralink_app
DB_PASSWORD=replace-with-a-long-random-password
DB_HOST=postgres.internal
DB_PORT=5432
DB_SSLMODE=verify-full

# Redis debe requerir contraseña y no exponerse a Internet.
REDIS_URL=redis://:replace-with-a-long-random-password@redis.internal:6379/0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password-or-smtp-secret
DEFAULT_FROM_EMAIL=no-reply@example.com
